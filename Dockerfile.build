# Build-only image for the STT client. Produces the `stt` binary on the host
# without requiring Go or gcc to be installed locally.
#
# Usage:
#   docker build -f Dockerfile.build -t stt-client-build .
#   docker run --rm -v $PWD/dist:/out stt-client-build
#   # binary appears at ./dist/stt
#
# The binary still requires PipeWire/Pulse + evdev on the *host* at runtime —
# this is a build helper, not a way to run the client containerized.

FROM golang:1.23-bookworm AS build

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        gcc libc6-dev libasound2-dev pkg-config && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download

COPY . .
ENV CGO_ENABLED=1
RUN go build -trimpath -ldflags="-s -w" -o /tmp/stt ./cmd/scriber

ENTRYPOINT ["/bin/cp", "/tmp/stt", "/out/stt"]
